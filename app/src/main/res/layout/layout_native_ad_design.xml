<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"

    android:layout_height="wrap_content">

<!--    <androidx.cardview.widget.CardView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:background="@null"-->
<!--        android:elevation="@dimen/_4sdp"-->
<!--        app:cardCornerRadius="@dimen/_8sdp">-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/nativecardview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="@dimen/_4sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardBackgroundColor="#FFE67050"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                   android:padding="@dimen/_5sdp"
                    >

                    <com.google.android.gms.ads.nativead.MediaView
                        android:id="@+id/ad_media"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_140sdp"
           android:visibility="gone"

                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/qwertyconstraintLayout2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="1.0">

                        <TextView
                            android:id="@+id/adtexttv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@color/black"
                            android:fontFamily="@font/segoe_regular"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="2dp"
                            android:text="Ad"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_9ssp"
                            app:layout_constraintStart_toEndOf="@+id/iconcard"
                            app:layout_constraintTop_toTopOf="@+id/cardView12" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/iconcard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_2sdp"

                            android:contentDescription="@string/app_name"
                            app:cardCornerRadius="@dimen/_8sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:srcCompat="@tools:sample/avatars[0]">

                            <ImageView
                                android:id="@+id/ad_app_icon"
                                android:layout_width="@dimen/_40sdp"
                                android:layout_height="@dimen/_40sdp"

                                android:contentDescription="@string/app_name"
                                tools:srcCompat="@tools:sample/avatars[0]" />
                        </androidx.cardview.widget.CardView>


                        <TextView
                            android:id="@+id/ad_headline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/segoe_bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/cardView12"
                            app:layout_constraintStart_toEndOf="@+id/adtexttv"
                            app:layout_constraintTop_toTopOf="@+id/cardView12"
                            tools:text="ad headline" />

                        <TextView
                            android:id="@+id/ad_body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/segoe_regular"
                            android:maxLines="2"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@+id/ad_headline"
                            app:layout_constraintStart_toEndOf="@+id/iconcard"
                            app:layout_constraintTop_toBottomOf="@+id/ad_headline"
                            tools:text="ad_body" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardView12"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_35sdp"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:padding="@dimen/_2sdp"
                            app:cardBackgroundColor="#FFE67050"
                            app:cardCornerRadius="10dp"
                            app:layout_constraintBottom_toBottomOf="@+id/iconcard"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/iconcard">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/ad_call_to_action"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35sdp"
                                android:layout_marginBottom="@dimen/_4sdp"
                                android:background="@drawable/round_corner_blue"
                                android:fontFamily="@font/segoe_regular"
                                android:gravity="center"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:maxLines="1"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/_12ssp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="test" />

                        </androidx.cardview.widget.CardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>



        </androidx.constraintlayout.widget.ConstraintLayout>

<!--    </androidx.cardview.widget.CardView>-->
</com.google.android.gms.ads.nativead.NativeAdView>