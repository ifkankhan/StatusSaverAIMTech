<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/roundedcorner_bg"
    android:paddingVertical="@dimen/_5sdp"
    android:layout_height="wrap_content">


    <androidx.cardview.widget.CardView
        android:id="@+id/small_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:backgroundTint="@color/white"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="5dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toStartOf="@+id/installbtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/installbtn" />


    <androidx.cardview.widget.CardView
        android:id="@+id/textview1"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:backgroundTint="@color/white"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toStartOf="@+id/installbtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/small_image" />

    <androidx.cardview.widget.CardView
        android:id="@+id/tasss"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:backgroundTint="@color/white"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        android:layout_marginTop="@dimen/_5sdp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="@id/textview1"
        app:layout_constraintStart_toStartOf="@id/textview1"
        app:layout_constraintTop_toBottomOf="@+id/textview1" />


    <androidx.cardview.widget.CardView
        android:id="@+id/installbtn"
        android:layout_width="0dp"
        android:layout_height="@dimen/_124sdp"
        android:layout_margin="@dimen/_5sdp"
        android:backgroundTint="@color/white"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.6" />

    <androidx.cardview.widget.CardView
        android:id="@+id/btn"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_margin="@dimen/_5sdp"
        android:backgroundTint="@color/white"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tasss"
        app:layout_constraintStart_toStartOf="@+id/tasss"
        app:layout_constraintTop_toBottomOf="@+id/tasss"
        app:layout_constraintWidth_percent="0.6" />

    <TextView
        android:id="@+id/native_ad_loading_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:elevation="@dimen/_4sdp"

        android:gravity="center"
        android:text="Ad Loading"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/installbtn"
        app:layout_constraintEnd_toEndOf="@+id/installbtn"
        app:layout_constraintStart_toStartOf="@+id/installbtn"
        app:layout_constraintTop_toTopOf="@+id/installbtn" />

</androidx.constraintlayout.widget.ConstraintLayout>