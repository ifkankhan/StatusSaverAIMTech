<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"

    android:layout_height="wrap_content">

    <!--    <androidx.cardview.widget.CardView-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:background="@null"-->
    <!--        android:elevation="@dimen/_4sdp"-->
    <!--        app:cardCornerRadius="@dimen/_8sdp">-->


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"

        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/nativecardview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="@dimen/_4sdp"
            app:cardBackgroundColor="#FFE67050"
            app:cardCornerRadius="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingVertical="@dimen/_10sdp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvbtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:padding="@dimen/_2sdp"

                    app:cardBackgroundColor="#FFE67050"
                    app:cardCornerRadius="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"

                    >

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/ad_call_to_action"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"


                        android:background="@drawable/round_corner_blue"
                        android:fontFamily="@font/segoe_regular"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_12ssp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="test" />

                </androidx.cardview.widget.CardView>

                <!--                <androidx.appcompat.widget.AppCompatButton-->
                <!--                    android:id="@+id/ad_call_to_action"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="@dimen/_40sdp"-->
                <!--                    android:layout_marginTop="@dimen/_5sdp"-->
                <!--                    android:layout_marginHorizontal="@dimen/_5sdp"-->

                <!--                    android:layout_marginBottom="@dimen/_4sdp"-->
                <!--                    android:background="@drawable/round_corner_red"-->
                <!--                    android:gravity="center"-->
                <!--                    android:paddingStart="20dp"-->
                <!--                    android:paddingEnd="20dp"-->
                <!--                    android:textColor="@android:color/white"-->
                <!--                    android:textSize="@dimen/_14ssp"-->

                <!--                   -->
                <!--                    tools:text="test" />-->


                <com.google.android.gms.ads.nativead.MediaView
                    android:id="@+id/ad_media"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_140sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:visibility="gone"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cvbtn" />


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/qwertyconstraintLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_5sdp"
                    app:layout_constraintBottom_toTopOf="@+id/cvbtn"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:id="@+id/adtexttv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@color/black"
                        android:fontFamily="@font/segoe_regular"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="2dp"
                        android:text="Ad"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9ssp"
                        app:layout_constraintBottom_toBottomOf="@+id/ad_headline"
                        app:layout_constraintStart_toEndOf="@+id/ad_app_icon"
                        app:layout_constraintTop_toTopOf="@+id/ad_app_icon" />

                    <ImageView
                        android:id="@+id/ad_app_icon"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_8sdp"


                        android:contentDescription="@string/app_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:srcCompat="@tools:sample/avatars[0]" />

                    <TextView
                        android:id="@+id/ad_headline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginEnd="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/segoe_bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/adtexttv"
                        app:layout_constraintTop_toTopOf="@+id/ad_app_icon"
                        tools:text="ad headline" />

                    <TextView
                        android:id="@+id/ad_body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/segoe_regular"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ad_app_icon"
                        app:layout_constraintTop_toBottomOf="@+id/ad_headline"
                        tools:text="ad_body" />


                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--    </androidx.cardview.widget.CardView>-->
</com.google.android.gms.ads.nativead.NativeAdView>